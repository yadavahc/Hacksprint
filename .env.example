# Copy to .env.local. Every key is optional — without them Maadi runs in DEMO MODE
# (deterministic, grounded responses and simulated voice). Keys are only read server-side.

# Language model for intent understanding and grounded phrasing. First configured wins:
# Groq → Gemini → Anthropic. The others become automatic fallbacks.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini — text fallback, and the model that reads uploaded invoices / GST returns / statements.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_VISION_MODEL=gemini-3.5-flash

# Optional: Anthropic Claude as a further fallback.
ANTHROPIC_API_KEY=

# Sarvam AI — Indian-language speech-to-text (saaras:v3) and text-to-speech (bulbul:v3).
SARVAM_API_KEY=

# Paytm Payment Gateway test credentials for real sandbox payments (Dashboard → Developer Settings → API Keys, Test mode).
# PAYTM_ENV=staging uses securegw-stage.paytm.in; no real money moves. Leave empty to keep payments simulated.
PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_ENV=staging

